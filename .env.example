# ==============================================================================
# "À la carte" — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For production (Vercel):
#   Set these variables in your Vercel Project Settings > Environment Variables.
#
# For Supabase Edge Functions Secrets:
#   Set via CLI: npx supabase secrets set KEY=VALUE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client Configuration (Frontend)
# ------------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 2. Stripe Prices (Frontend - Checkout)
# ------------------------------------------------------------------------------
# In Development (Test Mode): price_test_... from Stripe Dashboard (Test Mode)
# In Production (Live Mode): price_live_... created in Stripe Dashboard (Live Mode)
#
# Formules :
# - Mensuel : 4,80 € / mois (récurrent)
# - Annuel  : 42,00 € / an (récurrent)
VITE_STRIPE_PRICE_MONTHLY="price_1T3IihL2Gl5nOoCmHQufnxOA"
VITE_STRIPE_PRICE_ANNUAL="price_1T3IipL2Gl5nOoCmkV60vAei"

# ------------------------------------------------------------------------------
# 3. Error Tracking & Analytics (Frontend)
# ------------------------------------------------------------------------------
# Sentry DSN for frontend crash reporting & white-screen alerts
VITE_SENTRY_DSN=""

# Umami Analytics (GDPR/CNIL compliant, cookie-free)
# Get your website ID from your Umami dashboard (Cloud or Self-hosted)
VITE_UMAMI_WEBSITE_ID=""
# Optional custom script URL (defaults to "https://cloud.umami.is/script.js"):
# VITE_UMAMI_SCRIPT_URL="https://cloud.umami.is/script.js"

# ------------------------------------------------------------------------------
# 4. Environment & Production URLs (Optional / Defaults provided in environment.ts)
# ------------------------------------------------------------------------------
# VITE_PROD_URL="https://alacarte.app"
# VITE_BETA_URL="https://beta.alacarte.app"
# VITE_IS_BETA="false"

# ------------------------------------------------------------------------------
# 5. Supabase Edge Functions Secrets (Backend - DO NOT put in frontend .env)
# ------------------------------------------------------------------------------
# Set these on Supabase via CLI:
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   npx supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#   npx supabase secrets set GEMINI_API_KEY=AIzaSy...
#
# Keys required by Edge Functions:
# - STRIPE_SECRET_KEY       (Stripe API Secret Key: sk_test_... or sk_live_...)
# - STRIPE_WEBHOOK_SECRET   (Stripe Webhook Signing Secret: whsec_...)
# - GEMINI_API_KEY          (Google Gemini API Key for AI features & Vision)
# - SUPABASE_SERVICE_ROLE_KEY (Automatically injected by Supabase platform)
